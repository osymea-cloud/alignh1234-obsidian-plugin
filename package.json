{
  "name": "h1-renumber",
  "version": "1.1.0",
  "description": "Obsidian plugin that renumbers H1 headings in document order.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "eslint": "^10.14.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.2"
  }
}
